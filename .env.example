GEMMA4_12B_BASE_URL=http://127.0.0.1:8102/v1
QWEN35_27B_BASE_URL=http://127.0.0.1:8111/v1
QWEN35_9B_BASE_URL=http://127.0.0.1:8112/v1
QWEN35_2B_BASE_URL=http://127.0.0.1:8113/v1
QWEN35_08B_BASE_URL=http://127.0.0.1:8114/v1
