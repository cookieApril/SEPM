# Copy this file to .env for local use. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Shared SEPM database used by external benchmark adapters.
SEPM_DB=benchmark-results/sepm-external.db

# Optional local OpenAI-compatible services.
LOCAL_LLM_API_KEY=
